views:
  - type: table
    name: Tabela
    filters:
      and:
        - file.inFolder("remote/Base")
    order:
      - file.name
      - Data
      - status
      - tags
    sort:
      - property: file.name
        direction: DESC
  - type: cards
    name: Cartões
    filters:
      and:
        - file.inFolder("remote/Base")
    order:
      - file.name
      - status
      - Data
      - tags
    cardSize: 800
    imageAspectRatio: 1.05
