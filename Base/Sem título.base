views:
  - type: table
    name: Tabela
    filters:
      and:
        - file.inFolder("remote/Base")
    order:
      - file.name
      - Data
      - status
      - tags
    sort:
      - property: file.name
        direction: DESC
  - type: cards
    name: Cartões
    filters:
      and:
        - file.inFolder("remote/Base")
    order:
      - file.name
      - status
      - Data
      - tags
    cardSize: 800
    imageAspectRatio: 1.05
  - type: timeline
    name: Visualizaçao padrão
    filters:
      and:
        - file.inFolder("remote/Base")
    order:
      - file.name
      - Data
      - status
      - tags
      - file.tags
      - file.size
      - file.path
      - file.mtime
      - file.links
      - file.folder
      - file.ext
      - file.embeds
      - file.ctime
      - file.basename
      - file.backlinks
      - file.fullname
    showLabels: false
  - type: timeline
    name: Visualizaçao padrão 2
    order:
      - file.name
      - Data
    showLabels: true
    dateProperty: note.Data
    labelProperty: file.tags
  - type: timeline
    name: Visualizaçao padrão 2 2
    order:
      - file.name
      - Data
    showLabels: true
    dateProperty: note.Data
    labelProperty: file.basename
    categoryProperty: note.Data
  - type: table
    name: Visualizaçao padrão 3
