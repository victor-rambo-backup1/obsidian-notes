views:
  - type: project-timeline
    name: Timeline
    filters:
      and:
        - file.inFolder("remote/GTD/Minhas Ações")
    order:
      - file.name
      - Data Fim
      - Data Início
    priority: note.tags
    start: note.Data Início
    end: note.Data Fim
    sidebar: false
    zoom: week
  - type: table
    name: Tabela
    filters:
      and:
        - file.inFolder("remote/GTD/Minhas Ações")
    order:
      - file.name
      - Data
      - status
      - tags
    sort:
      - property: tags
        direction: DESC
