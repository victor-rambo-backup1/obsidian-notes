properties:
  file.name:
    displayName: Nome
views:
  - type: table
    name: Tabela
    filters:
      and:
        - file.inFolder("remote/GTD/Minhas Ações")
    order:
      - file.name
      - tags
      - Data Início
      - Data Fim
      - Status
    sort:
      - property: tags
        direction: ASC
      - property: Data Início
        direction: DESC
      - property: Status
        direction: ASC
  - type: project-timeline
    name: Timeline
    filters:
      and:
        - file.inFolder("remote/GTD/Minhas Ações")
    order:
      - file.name
      - Data Fim
      - Data Início
    sort:
      - property: Data Início
        direction: ASC
    priority: note.tags
    start: note.Data Início
    end: note.Data Fim
    sidebar: false
    zoom: week
